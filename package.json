{
  "name": "gojoclaw",
  "version": "1.0.0",
  "description": "ADK 2.0 Personal Assistant Agent with multi-channel integration (WhatsApp, Telegram, Discord) and tools (shell, file, browser)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
    "dev:cli": "npx adk run agent.ts",
    "dev:web": "npx adk web"
  },
  "dependencies": {
    "@google/adk": "^1.3.0",
    "discord.js": "^14.15.3",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "googleapis": "^173.0.0",
    "qrcode-terminal": "^0.12.0",
    "telegraf": "^4.16.3",
    "whatsapp-web.js": "^1.26.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@google/adk-devtools": "^1.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.9",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.5.2"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true,
    "puppeteer@24.38.0": true,
    "sqlite3@5.1.7": true
  }
}
